    "Mss-01-sec.footerTitle" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweitert das Terminal in den Streifen des Home-Indikators am unteren Bildschirmrand. Wirkt nur mit angeschlossener externer Tastatur und aktiviertem „Bei externer Tastatur ausblenden“ oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extends the terminal into the home-indicator strip at the bottom of the screen. Only takes effect with an external keyboard connected and “Hide with external keyboard” turned on above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extiende la terminal a la franja del indicador de inicio en la parte inferior de la pantalla. Solo tiene efecto con un teclado externo conectado y “Ocultar con teclado externo” activado arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étend le terminal dans la bande de l'indicateur d'accueil en bas de l'écran. Ne prend effet qu'avec un clavier externe connecté et « Masquer avec un clavier externe » activé ci-dessus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルを画面下部のホームインジケータ部分まで広げます。外部キーボードが接続され、上の“外部キーボード接続時に隠す”がオンの場合にのみ有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널을 화면 하단의 홈 인디케이터 영역까지 확장합니다. 외장 키보드가 연결되어 있고 위의 “외장 키보드 사용 시 숨기기”가 켜져 있을 때만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estende o terminal até a faixa do indicador de início na parte inferior da tela. Só tem efeito com um teclado externo conectado e “Ocultar com teclado externo” ativado acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растягивает терминал на полосу индикатора «Домой» внизу экрана. Действует только при подключённой внешней клавиатуре и включённом параметре «Скрывать при внешней клавиатуре» выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将终端扩展到屏幕底部的主屏幕指示条区域。仅在连接外接键盘且上方已打开“连接外接键盘时隐藏”时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將終端機延伸到螢幕底部的主畫面指示器區域。僅在連接外接鍵盤且已開啟上方「使用外接鍵盤時隱藏」時生效。"
          }
        }
      }
    },
