    "d0T-DL-SuP.footerTitle" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: Änderungen hier können alles kaputt machen! Falls das passiert, gibt es in der App „Einstellungen“ einen Schalter zum Zurücksetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Changing these can break everything! If that happens, there's a reset switch in the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: cambiar esto puede estropearlo todo. Si ocurre, hay un interruptor de restablecimiento en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention : modifier ces options peut tout casser ! Dans ce cas, un interrupteur de réinitialisation se trouve dans l'app Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告: これらを変更するとすべてが動作しなくなる可能性があります！ その場合は、“設定”App にリセットスイッチがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고: 이 항목을 변경하면 모든 것이 망가질 수 있습니다! 그런 경우 설정 앱에 재설정 스위치가 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: alterar estes itens pode quebrar tudo! Se isso acontecer, há um botão de redefinição no app Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание: изменение этих параметров может всё сломать! Если это случится, в приложении «Настройки» есть переключатель сброса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：更改这些设置可能导致一切无法正常工作！如果发生这种情况，“设置”App 中有一个重置开关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：更改這些設定可能會破壞一切！若發生這種情況，「設定」App 中有重置開關。"
          }
        }
      }
    },
