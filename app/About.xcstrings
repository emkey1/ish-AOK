    "Kaj-9x-pfF.footerTitle" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Zusatztasten ausgeblendet sind, öffnet der Kurzbefehl ⌘, die Einstellungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When extra keys are hidden, Settings can be opened with the ⌘, shortcut"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando las teclas adicionales están ocultas, Ajustes se puede abrir con el atajo ⌘,"
