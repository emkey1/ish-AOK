    "tuR-Og-SE8.footerTitle" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bildschirm eingeschaltet lassen“ verhindert das Abdunkeln, solange iSH-AOK im Vordergrund ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Screen Turned On prevents dimming while iSH-AOK is foregrounded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener la pantalla encendida evita que se atenúe mientras iSH-AOK está en primer plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder l'écran allumé empêche l'atténuation de l'écran lorsque iSH-AOK est au premier plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「画面を常にオン」は、iSH-AOK がフォアグラウンドにある間、画面が暗くなるのを防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 켜진 상태로 유지는 iSH-AOK가 포그라운드에 있는 동안 화면이 어두워지지 않도록 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter a Tela Ligada evita o escurecimento enquanto o iSH-AOK está em primeiro plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Не выключать экран» предотвращает затемнение, пока iSH-AOK на переднем плане."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“保持屏幕常亮”可在 iSH-AOK 位于前台时防止屏幕变暗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「保持螢幕開啟」可在 iSH-AOK 位於前景時防止螢幕變暗。"
          }
        }
      }
    },
