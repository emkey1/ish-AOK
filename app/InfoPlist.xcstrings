    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In AOK-Workstation laufende Programme dürfen deinen Standort sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programs running in AOK-Workstation will be allowed to see your location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los programas que se ejecutan en AOK-Workstation podrán ver tu ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les programmes exécutés dans AOK-Workstation pourront voir votre position."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation で実行されるプログラムが、位置情報を参照できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation에서 실행 중인 프로그램이 사용자의 위치를 볼 수 있게 됩니다."
          }
        },
