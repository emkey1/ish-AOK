    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist erforderlich, um eine Verbindung zu localhost herzustellen und den Befehl ping zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is required for connecting to localhost and using the ping command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es necesario para conectarse a localhost y usar el comando ping."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour se connecter à localhost et utiliser la commande ping."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "localhost への接続と ping コマンドの使用に必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "localhost에 연결하고 ping 명령을 사용하려면 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é necessário para conectar ao localhost e usar o comando ping."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это нужно для подключения к localhost и использования команды ping."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接到 localhost 和使用 ping 命令时需要此权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線至 localhost 及使用 ping 指令時需要此權限。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In iSH-AOK laufende Programme dürfen deinen Standort im Hintergrund verfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programs running in iSH-AOK will be allowed to track your location in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los programas que se ejecutan en iSH-AOK podrán rastrear tu ubicación en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les programmes exécutés dans iSH-AOK pourront suivre votre position en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iSH-AOK で実行されるプログラムが、バックグラウンドで位置情報を追跡できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iSH-AOK에서 실행 중인 프로그램이 백그라운드에서 사용자의 위치를 추적할 수 있게 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programas executados no iSH-AOK poderão rastrear sua localização em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программы, запущенные в iSH-AOK, смогут отслеживать вашу геопозицию в фоновом режиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iSH-AOK 中运行的程序将可以在后台跟踪你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iSH-AOK 中執行的程式將可在背景追蹤你的位置。"
          }
        }
      }
    },
