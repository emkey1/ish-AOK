    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation fügt deiner Fotomediathek etwas hinzu, wenn du „Bild sichern“ wählst oder ein konvertiertes Video in Fotos sicherst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation adds to your photo library when you choose Save Image, or save a converted video to Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation añade a tu fototeca cuando eliges Guardar imagen o guardas un vídeo convertido en Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation ajoute à votre photothèque lorsque vous choisissez Enregistrer l’image ou enregistrez une vidéo convertie dans Photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「イメージを保存」を選んだときや、変換したビデオを写真に保存するときに、AOK-Workstation は写真ライブラリに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지 저장을 선택하거나 변환된 비디오를 사진에 저장할 때 AOK-Workstation이 사진 보관함에 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AOK-Workstation adiciona à sua fototeca quando você escolhe Salvar Imagem ou salva um vídeo convertido em Fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation добавляет в медиатеку, когда вы выбираете «Сохранить изображение» или сохраняете сконвертированное видео в Фото."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你选择“存储图像”或将转换后的视频存储到照片时，AOK-Workstation 会向你的照片图库添加内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你選擇「儲存影像」或將轉換後的影片儲存到照片時，AOK-Workstation 會向你的照片圖庫加入內容。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation löscht ein Video aus deiner Mediathek nur, wenn du im Medienkonverter „Original löschen“ wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation deletes a video from your library only when you choose Delete Original in the Media Converter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation solo elimina un vídeo de tu fototeca cuando eliges Eliminar original en el Conversor multimedia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation ne supprime une vidéo de votre photothèque que lorsque vous choisissez Supprimer l’original dans le Convertisseur multimédia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation がライブラリからビデオを削除するのは、メディアコンバータで「オリジナルを削除」を選んだときだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation은 미디어 변환기에서 원본 삭제를 선택할 때만 보관함에서 비디오를 삭제합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AOK-Workstation só apaga um vídeo da sua fototeca quando você escolhe Apagar Original no Conversor de Mídia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation удаляет видео из медиатеки, только когда вы выбираете «Удалить оригинал» в Конвертере медиа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当你在媒体转换器中选择“删除原视频”时，AOK-Workstation 才会从你的图库中删除视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有當你在媒體轉換器中選擇「刪除原始影片」時，AOK-Workstation 才會從你的圖庫中刪除影片。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}