{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Workstation"
          }
        }
      },
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iSH-AOK"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programme, die Sie in AOK-Workstation ausführen, etwa ssh, ping und curl, verbinden sich mit Geräten in Ihrem lokalen Netzwerk, und andere Geräte können sich mit Servern verbinden, die Sie starten, etwa sshd."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programs you run in AOK-Workstation, such as ssh, ping and curl, connect to devices on your local network, and other devices can connect to servers you start, such as sshd."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los programas que ejecutas en AOK-Workstation, como ssh, ping y curl, se conectan a dispositivos de tu red local, y otros dispositivos pueden conectarse a los servidores que inicies, como sshd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les programmes que vous lancez dans AOK-Workstation, comme ssh, ping et curl, se connectent aux appareils de votre réseau local, et d’autres appareils peuvent se connecter aux serveurs que vous démarrez, comme sshd."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation で実行する ssh、ping、curl などのプログラムがローカルネットワーク上のデバイスに接続します。また、sshd など起動したサーバにほかのデバイスから接続できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation에서 실행하는 ssh, ping, curl 같은 프로그램이 로컬 네트워크의 기기에 연결하며, sshd처럼 직접 시작한 서버에는 다른 기기가 연결할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os programas que você executa no AOK-Workstation, como ssh, ping e curl, conectam-se a dispositivos na sua rede local, e outros dispositivos podem se conectar aos servidores que você iniciar, como o sshd."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программы, которые вы запускаете в AOK-Workstation, например ssh, ping и curl, подключаются к устройствам в вашей локальной сети, а другие устройства могут подключаться к запущенным вами серверам, например sshd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 AOK-Workstation 中运行的程序（如 ssh、ping 和 curl）会连接本地网络上的设备，其他设备也可以连接你启动的服务器（如 sshd）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 AOK-Workstation 中執行的程式（例如 ssh、ping 和 curl）會連線至區域網路上的裝置，其他裝置也可以連線至你啟動的伺服器（例如 sshd）。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In AOK-Workstation laufende Programme dürfen deinen Standort im Hintergrund verfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programs running in AOK-Workstation will be allowed to track your location in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los programas que se ejecutan en AOK-Workstation podrán rastrear tu ubicación en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les programmes exécutés dans AOK-Workstation pourront suivre votre position en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation で実行されるプログラムが、バックグラウンドで位置情報を追跡できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOK-Workstation에서 실행 중인 프로그램이 백그라운드에서 사용자의 위치를 추적할 수 있게 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programas executados no AOK-Workstation poderão rastrear sua localização em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программы, запущенные в AOK-Workstation, смогут отслеживать вашу геопозицию в фоновом режиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 AOK-Workstation 中运行的程序将可以在后台跟踪你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 AOK-Workstation 中執行的程式將可在背景追蹤你的位置。"
          }
        }
      }
    },
