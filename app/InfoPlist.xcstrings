    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In iSH-AOK laufende Programme dürfen deinen Standort sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programs running in iSH-AOK will be allowed to see your location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los programas que se ejecutan en iSH-AOK podrán ver tu ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les programmes exécutés dans iSH-AOK pourront voir votre position."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iSH-AOK で実行されるプログラムが、位置情報を参照できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iSH-AOK에서 실행 중인 프로그램이 사용자의 위치를 볼 수 있게 됩니다."
          }
        },
