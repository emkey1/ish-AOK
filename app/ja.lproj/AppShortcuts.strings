/* The Siri phrases of app/ISHAppShortcuts.swift.
   AppShortcuts.xcstrings is refused below iOS 17 ("use AppShortcuts.strings
   for previous versions") and this app targets iOS 15, so this surface is a
   legacy .strings table per language rather than a catalogue. Every phrase
   must keep ${applicationName}: Siri matches a phrase only when the app name
   is in it. Keys come from the build's own extraction -- the AppShortcuts
   table of ExtractedAppShortcutsMetadata.stringsdata. */

"Open workspace in ${applicationName}" = "${applicationName}でワークスペースを開く";
"Show dashboard in ${applicationName}" = "${applicationName}でダッシュボードを表示";
"Open session shell in ${applicationName}" = "${applicationName}でセッションシェルを開く";
"Open shell in ${applicationName}" = "${applicationName}でシェルを開く";
"Open system console in ${applicationName}" = "${applicationName}でシステムコンソールを開く";
"Open console in ${applicationName}" = "${applicationName}でコンソールを開く";
"Open browser in ${applicationName}" = "${applicationName}でブラウザを開く";
"Show browser in ${applicationName}" = "${applicationName}でブラウザを表示";
"Open themes in ${applicationName}" = "${applicationName}でテーマを開く";
"Show themes in ${applicationName}" = "${applicationName}でテーマを表示";
"Open boot images in ${applicationName}" = "${applicationName}でブートイメージを開く";
"Show boot images in ${applicationName}" = "${applicationName}でブートイメージを表示";
