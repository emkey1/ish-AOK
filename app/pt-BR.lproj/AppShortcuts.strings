/* The Siri phrases of app/ISHAppShortcuts.swift.
   AppShortcuts.xcstrings is refused below iOS 17 ("use AppShortcuts.strings
   for previous versions") and this app targets iOS 15, so this surface is a
   legacy .strings table per language rather than a catalogue. Every phrase
   must keep ${applicationName}: Siri matches a phrase only when the app name
   is in it. Keys come from the build's own extraction -- the AppShortcuts
   table of ExtractedAppShortcutsMetadata.stringsdata. */

"Open workspace in ${applicationName}" = "Abrir o espaço de trabalho no ${applicationName}";
"Show dashboard in ${applicationName}" = "Mostrar o painel no ${applicationName}";
"Open session shell in ${applicationName}" = "Abrir o shell da sessão no ${applicationName}";
"Open shell in ${applicationName}" = "Abrir o shell no ${applicationName}";
"Open system console in ${applicationName}" = "Abrir o console do sistema no ${applicationName}";
"Open console in ${applicationName}" = "Abrir o console no ${applicationName}";
"Open browser in ${applicationName}" = "Abrir o navegador no ${applicationName}";
"Show browser in ${applicationName}" = "Mostrar o navegador no ${applicationName}";
"Open themes in ${applicationName}" = "Abrir os temas no ${applicationName}";
"Show themes in ${applicationName}" = "Mostrar os temas no ${applicationName}";
"Open boot images in ${applicationName}" = "Abrir as imagens de inicialização no ${applicationName}";
"Show boot images in ${applicationName}" = "Mostrar as imagens de inicialização no ${applicationName}";
