/* The Siri phrases of app/ISHAppShortcuts.swift.
   AppShortcuts.xcstrings is refused below iOS 17 ("use AppShortcuts.strings
   for previous versions") and this app targets iOS 15, so this surface is a
   legacy .strings table per language rather than a catalogue. Every phrase
   must keep ${applicationName}: Siri matches a phrase only when the app name
   is in it. Keys come from the build's own extraction -- the AppShortcuts
   table of ExtractedAppShortcutsMetadata.stringsdata. */

"Open workspace in ${applicationName}" = "Ouvrir l’espace de travail dans ${applicationName}";
"Show dashboard in ${applicationName}" = "Afficher le tableau de bord dans ${applicationName}";
"Open session shell in ${applicationName}" = "Ouvrir le shell de session dans ${applicationName}";
"Open shell in ${applicationName}" = "Ouvrir le shell dans ${applicationName}";
"Open system console in ${applicationName}" = "Ouvrir la console système dans ${applicationName}";
"Open console in ${applicationName}" = "Ouvrir la console dans ${applicationName}";
"Open browser in ${applicationName}" = "Ouvrir le navigateur dans ${applicationName}";
"Show browser in ${applicationName}" = "Afficher le navigateur dans ${applicationName}";
"Open themes in ${applicationName}" = "Ouvrir les thèmes dans ${applicationName}";
"Show themes in ${applicationName}" = "Afficher les thèmes dans ${applicationName}";
"Open boot images in ${applicationName}" = "Ouvrir les images de démarrage dans ${applicationName}";
"Show boot images in ${applicationName}" = "Afficher les images de démarrage dans ${applicationName}";
