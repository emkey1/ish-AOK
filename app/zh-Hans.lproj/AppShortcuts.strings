/* The Siri phrases of app/ISHAppShortcuts.swift.
   AppShortcuts.xcstrings is refused below iOS 17 ("use AppShortcuts.strings
   for previous versions") and this app targets iOS 15, so this surface is a
   legacy .strings table per language rather than a catalogue. Every phrase
   must keep ${applicationName}: Siri matches a phrase only when the app name
   is in it. Keys come from the build's own extraction -- the AppShortcuts
   table of ExtractedAppShortcutsMetadata.stringsdata. */

"Open workspace in ${applicationName}" = "在 ${applicationName} 中打开工作区";
"Show dashboard in ${applicationName}" = "在 ${applicationName} 中显示仪表板";
"Open session shell in ${applicationName}" = "在 ${applicationName} 中打开会话 Shell";
"Open shell in ${applicationName}" = "在 ${applicationName} 中打开 Shell";
"Open system console in ${applicationName}" = "在 ${applicationName} 中打开系统控制台";
"Open console in ${applicationName}" = "在 ${applicationName} 中打开控制台";
"Open browser in ${applicationName}" = "在 ${applicationName} 中打开浏览器";
"Show browser in ${applicationName}" = "在 ${applicationName} 中显示浏览器";
"Open themes in ${applicationName}" = "在 ${applicationName} 中打开主题";
"Show themes in ${applicationName}" = "在 ${applicationName} 中显示主题";
"Open boot images in ${applicationName}" = "在 ${applicationName} 中打开启动映像";
"Show boot images in ${applicationName}" = "在 ${applicationName} 中显示启动映像";
