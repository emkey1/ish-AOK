          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гостевая система ещё не запущена. Запустите оболочку или консоль, и здесь появятся последние строки журнала."
          }
        },
        "zh-Hans" : {
