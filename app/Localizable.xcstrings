    "This provider needs a key. It is stored with the destination and can be changed in Settings." : {
      "comment" : "API key alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Anbieter benötigt einen Schlüssel. Er wird mit dem Ziel gespeichert und kann in den Einstellungen geändert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proveedor necesita una clave. Se guarda con el destino y se puede cambiar en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fournisseur nécessite une clé. Elle est stockée avec la destination et peut être modifiée dans Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロバイダにはキーが必要です。キーは接続先と一緒に保存され、「設定」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 제공자는 키가 필요합니다. 키는 대상과 함께 저장되며 설정에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este provedor precisa de uma chave. Ela é guardada com o destino e pode ser alterada em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этому провайдеру нужен ключ. Он хранится вместе с подключением, и его можно изменить в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此提供商需要密钥。密钥与目标一起存储，可在“设置”中更改。"
