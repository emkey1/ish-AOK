          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гостевая система не смогла загрузиться (ошибка %ld). Откройте iSH-AOK один раз, чтобы завершить настройку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户机系统无法启动（错误 %ld）。请打开一次 iSH-AOK 以完成设置。"
