        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que muestra la tecla y el texto que escribe. \\e Escape, \\t Tabulador, \\n Retorno, \\xHH un carácter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu'affiche la touche, et le texte qu'elle tape. \\e Échap, \\t Tab, \\n Retour, \\xHH un caractère."
