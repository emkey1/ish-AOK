          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma tecla personalizada. Digita o texto definido para ela nos ajustes da Barra de Ferramentas do Teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Своя клавиша. Вводит текст, заданный для неё в настройках панели клавиатуры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义键。输入在“键盘工具栏”设置中为其设定的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
