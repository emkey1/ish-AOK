        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트 시스템이 아직 실행되지 않았습니다. 셸이나 콘솔을 시작하면 최근 로그 줄이 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
