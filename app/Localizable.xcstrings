    "Free storage space on the device, then restart iSH-AOK." : {
      "comment" : "Boot failure recovery advice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Speicherplatz auf dem Gerät frei und starte iSH-AOK neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera espacio de almacenamiento en el dispositivo y reinicia iSH-AOK."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez de l'espace de stockage sur l'appareil, puis redémarrez iSH-AOK."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスのストレージ容量を空けてから、iSH-AOK を再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 저장 공간을 확보한 후 iSH-AOK를 재시작하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libere espaço de armazenamento no dispositivo e reinicie o iSH-AOK."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освободите место на устройстве, затем перезапустите iSH-AOK."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请释放设备上的存储空间，然后重新启动 iSH-AOK。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釋放裝置上的儲存空間，然後重新啟動 iSH-AOK。"
          }
        }
      }
    },
