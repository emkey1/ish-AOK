          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルのコンテキストまたは保存済みのプロンプトテンプレートを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 컨텍스트 또는 저장된 프롬프트 템플릿을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o contexto do terminal ou modelos de prompt salvos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
