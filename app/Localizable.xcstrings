    "The requested boot filesystem does not exist" : {
      "comment" : "Boot failure alert title",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das angeforderte Boot-Dateisystem existiert nicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema de archivos de arranque solicitado no existe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système de fichiers de démarrage demandé n'existe pas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求されたブート用ファイルシステムが存在しません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청한 부팅 파일 시스템이 없음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema de arquivos de inicialização solicitado não existe"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрошенная файловая система для загрузки не существует"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求的启动文件系统不存在"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求的開機檔案系統不存在"
          }
        }
      }
    },
    "The root filesystem does not contain the default session command, and no fallback shell was found.\n\nCommand: %@\nError: %@\nFallbacks checked: %@\n\nInstall login or a shell such as /bin/sh, or change Settings -> Launch Command." : {
      "comment" : "Session start failure alert message; command, error, then the shells tried",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Root-Dateisystem enthält den Standard-Sitzungsbefehl nicht, und es wurde keine Ersatz-Shell gefunden.\n\nBefehl: %1$@\nFehler: %2$@\nGeprüfte Ersatz-Shells: %3$@\n\nInstalliere login oder eine Shell wie /bin/sh oder ändere Einstellungen -> Startbefehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The root filesystem does not contain the default session command, and no fallback shell was found.\n\nCommand: %1$@\nError: %2$@\nFallbacks checked: %3$@\n\nInstall login or a shell such as /bin/sh, or change Settings -> Launch Command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema de archivos raíz no contiene el comando de sesión predeterminado y no se encontró ninguna shell de reserva.\n\nComando: %1$@\nError: %2$@\nAlternativas comprobadas: %3$@\n\nInstala login o una shell como /bin/sh, o cambia Ajustes -> Comando de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système de fichiers racine ne contient pas la commande de session par défaut, et aucun shell de secours n'a été trouvé.\n\nCommande : %1$@\nErreur : %2$@\nShells de secours vérifiés : %3$@\n\nInstallez login ou un shell tel que /bin/sh, ou modifiez Réglages -> Commande de lancement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートファイルシステムにデフォルトのセッションコマンドが含まれておらず、代替シェルも見つかりませんでした。\n\nコマンド: %1$@\nエラー: %2$@\n確認した代替: %3$@\n\nlogin または /bin/sh などのシェルをインストールするか、「設定」->「起動コマンド」を変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "루트 파일 시스템에 기본 세션 명령이 없으며, 대체 셸도 찾을 수 없습니다.\n\n명령: %1$@\n오류: %2$@\n확인한 대체 셸: %3$@\n\nlogin 또는 /bin/sh 같은 셸을 설치하거나, 설정 -> 실행 명령을 변경하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema de arquivos raiz não contém o comando de sessão padrão, e nenhum shell alternativo foi encontrado.\n\nComando: %1$@\nErro: %2$@\nAlternativas verificadas: %3$@\n\nInstale o login ou um shell como /bin/sh, ou altere Ajustes -> Comando de Abertura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В корневой файловой системе нет команды сеанса по умолчанию, и резервная оболочка не найдена.\n\nКоманда: %1$@\nОшибка: %2$@\nПроверенные варианты: %3$@\n\nУстановите login или оболочку, например /bin/sh, или измените Настройки -> Команда запуска."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根文件系统不包含默认会话命令，且未找到后备 shell。\n\n命令：%1$@\n错误：%2$@\n已检查的后备：%3$@\n\n请安装 login 或 /bin/sh 等 shell，或更改“设置 -> 启动命令”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根檔案系統不包含預設的工作階段指令，也找不到備用 shell。\n\n指令：%1$@\n錯誤：%2$@\n已檢查的備用項目：%3$@\n\n請安裝 login 或 /bin/sh 等 shell，或更改「設定」->「啟動指令」。"
          }
        }
      }
    },
    "The root filesystem was mounted, but the session command could not be executed.\n\nCommand: %@\nPath: %@\nError: %@\n\nInstall the missing program, choose a root filesystem with a shell, or change Settings -> Launch Command." : {
      "comment" : "Session start failure alert message; command, path, then error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Root-Dateisystem wurde eingehängt, aber der Sitzungsbefehl konnte nicht ausgeführt werden.\n\nBefehl: %1$@\nPfad: %2$@\nFehler: %3$@\n\nInstalliere das fehlende Programm, wähle ein Root-Dateisystem mit einer Shell oder ändere Einstellungen -> Startbefehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The root filesystem was mounted, but the session command could not be executed.\n\nCommand: %1$@\nPath: %2$@\nError: %3$@\n\nInstall the missing program, choose a root filesystem with a shell, or change Settings -> Launch Command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se montó el sistema de archivos raíz, pero no se pudo ejecutar el comando de sesión.\n\nComando: %1$@\nRuta: %2$@\nError: %3$@\n\nInstala el programa que falta, elige un sistema de archivos raíz con una shell o cambia Ajustes -> Comando de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système de fichiers racine a été monté, mais la commande de session n'a pas pu être exécutée.\n\nCommande : %1$@\nChemin : %2$@\nErreur : %3$@\n\nInstallez le programme manquant, choisissez un système de fichiers racine avec un shell, ou modifiez Réglages -> Commande de lancement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートファイルシステムはマウントされましたが、セッションコマンドを実行できませんでした。\n\nコマンド: %1$@\nパス: %2$@\nエラー: %3$@\n\n不足しているプログラムをインストールするか、シェルのあるルートファイルシステムを選択するか、「設定」->「起動コマンド」を変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "루트 파일 시스템이 마운트되었지만 세션 명령을 실행할 수 없습니다.\n\n명령: %1$@\n경로: %2$@\n오류: %3$@\n\n누락된 프로그램을 설치하거나, 셸이 있는 루트 파일 시스템을 선택하거나, 설정 -> 실행 명령을 변경하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema de arquivos raiz foi montado, mas não foi possível executar o comando da sessão.\n\nComando: %1$@\nCaminho: %2$@\nErro: %3$@\n\nInstale o programa ausente, escolha um sistema de arquivos raiz com um shell ou altere Ajustes -> Comando de Abertura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Корневая файловая система подключена, но команду сеанса не удалось выполнить.\n\nКоманда: %1$@\nПуть: %2$@\nОшибка: %3$@\n\nУстановите недостающую программу, выберите корневую файловую систему с оболочкой или измените Настройки -> Команда запуска."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根文件系统已挂载，但无法执行会话命令。\n\n命令：%1$@\n路径：%2$@\n错误：%3$@\n\n请安装缺少的程序、选择带有 shell 的根文件系统，或更改“设置 -> 启动命令”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根檔案系統已掛載，但無法執行工作階段指令。\n\n指令：%1$@\n路徑：%2$@\n錯誤：%3$@\n\n請安裝缺少的程式、選擇含有 shell 的根檔案系統，或更改「設定」->「啟動指令」。"
          }
        }
      }
    },
    "The root's /dev entries may be damaged. Choose another filesystem or reimport this one." : {
      "comment" : "Boot failure recovery advice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die /dev-Einträge des Roots sind möglicherweise beschädigt. Wähle ein anderes Dateisystem oder importiere dieses erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas de /dev del sistema raíz pueden estar dañadas. Elige otro sistema de archivos o vuelve a importar este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées /dev de la racine sont peut-être endommagées. Choisissez un autre système de fichiers ou réimportez celui-ci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートの /dev エントリが破損している可能性があります。別のファイルシステムを選択するか、このファイルシステムを再インポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "루트의 /dev 항목이 손상되었을 수 있습니다. 다른 파일 시스템을 선택하거나 이 파일 시스템을 다시 가져오십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As entradas /dev da raiz podem estar danificadas. Escolha outro sistema de arquivos ou reimporte este."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи /dev в корневой ФС могут быть повреждены. Выберите другую файловую систему или повторно импортируйте эту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根文件系统的 /dev 条目可能已损坏。请选择其他文件系统或重新导入此文件系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根檔案系統的 /dev 項目可能已損壞。請選擇其他檔案系統或重新匯入此檔案系統。"
          }
        }
      }
    },
    "The saved session from this filesystem will be deleted too." : {
      "comment" : "Delete filesystem confirmation, one saved session",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gesicherte Sitzung dieses Dateisystems wird ebenfalls gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se eliminará la sesión guardada de este sistema de archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session enregistrée de ce système de fichiers sera aussi supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルシステムの保存済みセッションも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일 시스템에서 저장된 세션도 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão salva deste sistema de arquivos também será apagada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый сеанс этой файловой системы тоже будет удалён."
          }
        },
