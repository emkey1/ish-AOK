    "System halted. Quit and reopen iSH-AOK to boot it again." : {
      "comment" : "Terminal overlay after the guest halts",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System angehalten. Beende iSH-AOK und öffne es erneut, um wieder zu booten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema detenido. Sal de iSH-AOK y vuelve a abrirlo para arrancarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système arrêté. Quittez et rouvrez iSH-AOK pour le redémarrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムが停止しました。再度ブートするには、iSH-AOK を終了して開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템이 정지되었습니다. 다시 부팅하려면 iSH-AOK를 종료한 후 다시 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema parado. Saia e reabra o iSH-AOK para iniciá-lo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Система остановлена. Закройте и снова откройте iSH-AOK, чтобы загрузить её заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统已停止。退出并重新打开 iSH-AOK 以再次启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統已停止。請結束並重新打開 iSH-AOK 以再次開機。"
          }
        }
      }
    },
