    },
    "The filesystem metadata database may be incompatible or corrupt. Choose another filesystem or reimport this one." : {
      "comment" : "Boot failure recovery advice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Metadatenbank des Dateisystems ist möglicherweise inkompatibel oder beschädigt. Wähle ein anderes Dateisystem oder importiere dieses erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de datos de metadatos del sistema de archivos puede ser incompatible o estar dañada. Elige otro sistema de archivos o vuelve a importar este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La base de métadonnées du système de fichiers est peut-être incompatible ou corrompue. Choisissez un autre système de fichiers ou réimportez celui-ci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルシステムのメタデータデータベースに互換性がないか、破損している可能性があります。別のファイルシステムを選択するか、このファイルシステムを再インポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 시스템 메타데이터 데이터베이스가 호환되지 않거나 손상되었을 수 있습니다. 다른 파일 시스템을 선택하거나 이 파일 시스템을 다시 가져오십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O banco de metadados do sistema de arquivos pode estar incompatível ou corrompido. Escolha outro sistema de arquivos ou reimporte este."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "База метаданных файловой системы может быть несовместимой или повреждённой. Выберите другую файловую систему или повторно импортируйте эту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
