    },
    "This device has less than 4 GB of RAM. Workspace is more stable with fewer windows and browser tabs open. Browser tabs are limited to 2 on this device." : {
      "comment" : "low memory warning body",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat weniger als 4 GB RAM. Der Workspace ist stabiler mit weniger offenen Fenstern und Browser-Tabs. Browser-Tabs sind auf diesem Gerät auf 2 begrenzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene menos de 4 GB de RAM. El espacio de trabajo es más estable con menos ventanas y pestañas del navegador abiertas. Las pestañas del navegador están limitadas a 2 en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a moins de 4 Go de RAM. L'espace de travail est plus stable avec moins de fenêtres et d'onglets de navigateur ouverts. Les onglets de navigateur sont limités à 2 sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの RAM は 4 GB 未満です。ワークスペースは、開いているウインドウやブラウザタブが少ないほど安定します。このデバイスではブラウザタブは 2 つまでに制限されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 RAM이 4 GB 미만입니다. 윈도우와 브라우저 탭을 적게 열수록 워크스페이스가 더 안정적입니다. 이 기기에서는 브라우저 탭이 2개로 제한됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tem menos de 4 GB de RAM. O Espaço de trabalho fica mais estável com menos janelas e abas do navegador abertas. As abas do navegador são limitadas a 2 neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве меньше 4 GB ОЗУ. Рабочая область работает стабильнее, когда открыто меньше окон и вкладок браузера. На этом устройстве можно открыть не более 2 вкладок браузера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备的 RAM 少于 4 GB。打开较少的窗口和浏览器标签页时，工作区会更稳定。此设备上的浏览器标签页限制为 2 个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置的 RAM 少於 4 GB。打開較少的視窗和瀏覽器標籤頁時，工作區會更穩定。此裝置的瀏覽器標籤頁上限為 2 個。"
          }
        }
      }
    },
    "This device is limited to %lu browser tabs in Workspace based on its available RAM (%.0f GB)." : {
      "comment" : "browser tab limit alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät ist aufgrund seines verfügbaren RAM (%2$.0f GB) im Workspace auf %1$lu Browser-Tabs begrenzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device is limited to %1$lu browser tabs in Workspace based on its available RAM (%2$.0f GB)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo está limitado a %1$lu pestañas del navegador en el espacio de trabajo según su RAM disponible (%2$.0f GB)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil est limité à %1$lu onglets de navigateur dans l'espace de travail en fonction de sa RAM disponible (%2$.0f Go)."
          }
        },
        "ja" : {
          "stringUnit" : {
