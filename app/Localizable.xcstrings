    "%@\n\nTap Import to add a filesystem manually after freeing space." : {
      "comment" : "Filesystems list empty-state text; %@ is the import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nTippe auf „Importieren“, um ein Dateisystem manuell hinzuzufügen, nachdem du Speicher freigegeben hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nToca Importar para añadir un sistema de archivos manualmente después de liberar espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nTouchez Importer pour ajouter un système de fichiers manuellement après avoir libéré de l'espace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n空き容量を確保してから「インポート」をタップしてファイルシステムを手動で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n공간을 확보한 후 가져오기를 탭하여 파일 시스템을 직접 추가하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nToque em Importar para adicionar um sistema de arquivos manualmente após liberar espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nОсвободите место и коснитесь «Импорт», чтобы добавить файловую систему вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n释放空间后，轻点“导入”以手动添加文件系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n釋放空間後，點一下「匯入」以手動加入檔案系統。"
          }
        }
      }
    },
