    "No populated log files under /var/log. Many minimal rootfs's don't run a syslog daemon by default." : {
      "comment" : "Logs tool message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine befüllten Protokolldateien unter /var/log. Viele minimale rootfs starten standardmäßig keinen syslog-Daemon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay archivos de registro con contenido en /var/log. Muchos rootfs mínimos no ejecutan un daemon de syslog de forma predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun fichier journal rempli dans /var/log. Beaucoup de rootfs minimaux n'exécutent pas de démon syslog par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/var/log の下に内容のあるログファイルがありません。最小構成のルートファイルシステムの多くは、デフォルトでは syslog デーモンを実行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/var/log 아래에 내용이 있는 로그 파일이 없습니다. 많은 최소 rootfs는 기본적으로 syslog 데몬을 실행하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum arquivo de log com conteúdo em /var/log. Muitos rootfs mínimos não executam um daemon syslog por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В /var/log нет непустых файлов журналов. Многие минимальные rootfs по умолчанию не запускают демон syslog."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/var/log 下没有包含内容的日志文件。许多精简的根文件系统默认不运行 syslog 守护进程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/var/log 下沒有含內容的記錄檔。許多精簡的 rootfs 預設不執行 syslog 守護程式。"
          }
        }
      }
    },
