    "On. Last saved %lu process, %.1f MB. Saved again whenever iSH-AOK goes to the background." : {
      "comment" : "session suspend status: one process, size in MB",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An. Zuletzt %1$lu Prozess gesichert, %2$.1f MB. Wird erneut gesichert, sobald iSH-AOK in den Hintergrund geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On. Last saved %1$lu process, %2$.1f MB. Saved again whenever iSH-AOK goes to the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado. Último guardado: %1$lu proceso, %2$.1f MB. Se vuelve a guardar cada vez que iSH-AOK pasa a segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé. Dernier enregistrement : %1$lu processus, %2$.1f Mo. Réenregistré chaque fois qu'iSH-AOK passe en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オン。前回は %1$lu 個のプロセス、%2$.1f MB を保存しました。iSH-AOK がバックグラウンドに移るたびに再保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켬. 마지막 저장: 프로세스 %1$lu개, %2$.1f MB. iSH-AOK가 백그라운드로 전환될 때마다 다시 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativado. Último salvamento: %1$lu processo, %2$.1f MB. Salvo novamente sempre que o iSH-AOK vai para segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкл. Последнее сохранение: процессов: %1$lu, %2$.1f MB. Сохраняется снова при каждом уходе iSH-AOK в фон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启。上次保存了 %1$lu 个进程，%2$.1f MB。每当 iSH-AOK 进入后台时都会再次保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟。上次儲存 %1$lu 個程序，%2$.1f MB。每當 iSH-AOK 進入背景時都會再次儲存。"
          }
        }
      }
    },
