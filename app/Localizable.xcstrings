          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепить вкладку на текущей странице"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将标签页固定到当前页面"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將標籤頁固定到目前頁面"
          }
        }
      }
    },
    "Pin this tab so new tabs opened in this slot load its current page instead of Home." : {
      "comment" : "browser tab pin message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hefte diesen Tab an, damit neue Tabs an dieser Stelle die aktuelle Seite statt der Startseite laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija esta pestaña para que las nuevas pestañas abiertas en esta posición carguen su página actual en lugar de Inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épinglez cet onglet pour que les nouveaux onglets ouverts à cet emplacement chargent sa page actuelle au lieu de l'accueil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタブを固定すると、この位置で開いた新しいタブはホームではなく現在のページを読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 탭을 고정하면 이 슬롯에서 열리는 새 탭이 홈 대신 현재 페이지를 불러옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe esta aba para que novas abas abertas nesta posição carreguem a página atual em vez da Página Inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите эту вкладку, чтобы новые вкладки в этом слоте открывали её текущую страницу вместо домашней."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定此标签页，使在此位置打开的新标签页载入其当前页面，而不是主页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定此標籤頁，讓此位置打開的新標籤頁載入其目前頁面，而非首頁。"
          }
        }
      }
    },
    "Pinned to %@. New tabs opened in this slot load that page instead of Home." : {
      "comment" : "browser tab pin message; %@ is a URL",
      "localizations" : {
        "de" : {
          "stringUnit" : {
