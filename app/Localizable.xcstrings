    "What the key shows, and the text it types. \\e Escape, \\t Tab, \\n Return, \\xHH a character." : {
      "comment" : "Custom key editor message; keep the escape sequences unchanged",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was die Taste zeigt und welchen Text sie tippt. \\e Escape, \\t Tab, \\n Return, \\xHH ein Zeichen."
