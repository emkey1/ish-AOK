      }
    },
    "Use a customized color scheme for user interface elements (keyboard, status bar) rather than one that matches the current palette." : {
      "comment" : "Theme editor footer under UI Overrides",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eigenes Farbschema für Oberflächenelemente (Tastatur, Statusleiste) statt eines zur aktuellen Palette passenden verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un esquema de colores personalizado para los elementos de la interfaz (teclado, barra de estado) en lugar de uno que coincida con la paleta actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un jeu de couleurs personnalisé pour les éléments de l'interface (clavier, barre d'état) plutôt qu'un jeu assorti à la palette actuelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のパレットに合わせた配色ではなく、カスタマイズした配色をユーザインターフェイス要素（キーボード、ステータスバー）に使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 팔레트에 맞추는 대신 사용자 인터페이스 요소(키보드, 상태 막대)에 사용자 설정 색상 구성표를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar um esquema de cores personalizado para elementos da interface (teclado, barra de status) em vez de um que corresponda à paleta atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать отдельную цветовую схему для элементов интерфейса (клавиатура, строка состояния) вместо соответствующей текущей палитре."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为界面元素（键盘、状态栏）使用自定义配色方案，而不是与当前调色板匹配的方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為使用者介面元素（鍵盤、狀態列）使用自訂配色，而非符合目前調色盤的配色。"
          }
        }
      }
    },
    "Use terminal context or saved prompt templates." : {
      "comment" : "prompt actions action sheet message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalkontext oder gesicherte Prompt-Vorlagen verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el contexto de la terminal o plantillas de prompt guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
