      }
    },
    "The active filesystem data exists, but its fakefs metadata database is missing." : {
      "comment" : "Boot failure reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten des aktiven Dateisystems existieren, aber die fakefs-Metadatenbank fehlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del sistema de archivos activo existen, pero falta su base de datos de metadatos de fakefs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du système de fichiers actif existent, mais sa base de métadonnées fakefs est introuvable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなファイルシステムのデータはありますが、fakefs メタデータデータベースが見つかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 파일 시스템 데이터는 있지만 fakefs 메타데이터 데이터베이스가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do sistema de arquivos ativo existem, mas seu banco de metadados do fakefs está ausente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные активной файловой системы существуют, но база метаданных fakefs отсутствует."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活跃文件系统的数据存在，但缺少其 fakefs 元数据数据库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中的檔案系統資料存在，但缺少其 fakefs 後設資料資料庫。"
          }
        }
      }
    },
    "The active filesystem directory exists, but its data directory is missing." : {
      "comment" : "Boot failure reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner des aktiven Dateisystems existiert, aber sein Datenordner fehlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El directorio del sistema de archivos activo existe, pero falta su directorio de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le répertoire du système de fichiers actif existe, mais son répertoire de données est introuvable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなファイルシステムのディレクトリはありますが、データディレクトリが見つかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 파일 시스템 디렉터리는 있지만 데이터 디렉터리가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diretório do sistema de arquivos ativo existe, mas seu diretório de dados está ausente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог активной файловой системы существует, но каталог данных отсутствует."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活跃文件系统的目录存在，但缺少其数据目录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中的檔案系統目錄存在，但缺少其資料目錄。"
          }
        }
      }
    },
    "The active filesystem points to a root directory that is not present on disk." : {
      "comment" : "Boot failure reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktive Dateisystem verweist auf einen Root-Ordner, der nicht auf dem Speicher vorhanden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema de archivos activo apunta a un directorio raíz que no está en el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système de fichiers actif pointe vers un répertoire racine absent du disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなファイルシステムが、ディスク上に存在しないルートディレクトリを指しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 파일 시스템이 디스크에 없는 루트 디렉터리를 가리킵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema de arquivos ativo aponta para um diretório raiz que não está presente no disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активная файловая система указывает на корневой каталог, которого нет на диске."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活跃文件系统指向的根目录在磁盘上不存在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中的檔案系統指向磁碟上不存在的根目錄。"
          }
        }
      }
    },
    "The application delegate was not available when boot was requested." : {
      "comment" : "Boot failure reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App-Delegate war beim Anfordern des Bootvorgangs nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El delegado de la aplicación no estaba disponible cuando se solicitó el arranque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le délégué de l'application n'était pas disponible au moment de la demande de démarrage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブートが要求されたときにアプリケーションデリゲートが利用できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부팅이 요청되었을 때 앱 델리게이트를 사용할 수 없었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O delegate do aplicativo não estava disponível quando a inicialização foi solicitada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делегат приложения был недоступен в момент запроса загрузки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求启动时 App 委托不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求開機時，App 委派不可用。"
          }
        }
      }
    },
    "The boot command was loaded, but iSH-AOK could not create a thread to run it." : {
      "comment" : "Boot failure reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bootbefehl wurde geladen, aber iSH-AOK konnte keinen Thread zum Ausführen erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cargó el comando de arranque, pero iSH-AOK no pudo crear un hilo para ejecutarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La commande de démarrage a été chargée, mais iSH-AOK n'a pas pu créer de thread pour l'exécuter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブートコマンドは読み込まれましたが、iSH-AOK はそれを実行するスレッドを作成できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
