          }
        }
      }
    },
    "The guest system isn't running yet. Start a shell or console, then recent log lines will appear here." : {
      "comment" : "Logs tool message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gastsystem läuft noch nicht. Starte eine Shell oder Konsole, dann erscheinen hier die letzten Protokollzeilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema invitado aún no se está ejecutando. Inicia una shell o una consola y aquí aparecerán las líneas recientes del registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système invité n'est pas encore en cours d'exécution. Lancez un shell ou une console, et les lignes récentes du journal apparaîtront ici."
