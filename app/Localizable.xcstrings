    "Could not start the command (error %d). Is the guest system booted?" : {
      "comment" : "Shortcuts Run Command failure; %d is an error number",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl konnte nicht gestartet werden (Fehler %d). Ist das Gastsystem gebootet?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar el comando (error %d). ¿Se ha arrancado el sistema invitado?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lancer la commande (erreur %d). Le système invité est-il démarré ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドを開始できませんでした（エラー %d）。ゲストシステムはブートしていますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령을 시작할 수 없습니다(오류 %d). 게스트 시스템이 부팅되어 있습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o comando (erro %d). O sistema convidado foi inicializado?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить команду (ошибка %d). Гостевая система загружена?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动命令（错误 %d）。客户机系统是否已启动？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法啟動指令（錯誤 %d）。客體系統已開機了嗎？"
          }
        }
      }
    },
    "Could not start the command as user \"%@\" (error %d). The \"Open Everything as Default User\" setting runs commands via /bin/su -- if su is missing or that account cannot log in, disable the setting or fix the account." : {
      "comment" : "Shortcuts Run Command failure; %@ is a user name, %d an error number",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl konnte nicht als Benutzer „%1$@“ gestartet werden (Fehler %2$d). Die Einstellung „Alles als Standardbenutzer öffnen“ führt Befehle über /bin/su aus – fehlt su oder kann sich das Konto nicht anmelden, deaktiviere die Einstellung oder repariere das Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not start the command as user \"%1$@\" (error %2$d). The \"Open Everything as Default User\" setting runs commands via /bin/su -- if su is missing or that account cannot log in, disable the setting or fix the account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar el comando como el usuario \"%1$@\" (error %2$d). El ajuste \"Abrir todo como usuario predeterminado\" ejecuta los comandos mediante /bin/su -- si falta su o esa cuenta no puede iniciar sesión, desactiva el ajuste o corrige la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lancer la commande en tant qu'utilisateur \"%1$@\" (erreur %2$d). Le réglage « Tout ouvrir en tant qu'utilisateur par défaut » exécute les commandes via /bin/su -- si su est absent ou si ce compte ne peut pas se connecter, désactivez le réglage ou corrigez le compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザ“%1$@”としてコマンドを開始できませんでした（エラー %2$d）。「すべてをデフォルトユーザとして開く」設定は /bin/su 経由でコマンドを実行します -- su がない場合やそのアカウントでログインできない場合は、設定をオフにするかアカウントを修正してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 \"%1$@\"(으)로 명령을 시작할 수 없습니다(오류 %2$d). \"모든 항목을 기본 사용자로 열기\" 설정은 /bin/su를 통해 명령을 실행합니다 -- su가 없거나 해당 계정으로 로그인할 수 없다면 설정을 끄거나 계정을 수정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o comando como usuário \"%1$@\" (erro %2$d). O ajuste \"Abrir Tudo como Usuário Padrão\" executa comandos via /bin/su -- se o su estiver ausente ou essa conta não puder fazer login, desative o ajuste ou corrija a conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить команду от имени пользователя \"%1$@\" (ошибка %2$d). Настройка «Открывать всё от имени пользователя по умолчанию» запускает команды через /bin/su — если su отсутствует или эта учётная запись не может войти, отключите настройку или исправьте учётную запись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法以用户“%1$@”启动命令（错误 %2$d）。“以默认用户打开所有内容”设置通过 /bin/su 运行命令——如果缺少 su 或该账户无法登录，请停用该设置或修复该账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法以使用者 \"%1$@\" 啟動指令（錯誤 %2$d）。「以預設使用者打開所有項目」設定會透過 /bin/su 執行指令 -- 如果缺少 su 或該帳號無法登入，請停用此設定或修正該帳號。"
          }
        }
      }
    },
