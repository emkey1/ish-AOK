    "Hide Thinking" : {
      "comment" : "LLM settings row",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denkprozess ausblenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar razonamiento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer la réflexion"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思考を隠す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생각 숨기기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar Raciocínio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать рассуждения"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏思考过程"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏思考過程"
          }
        }
      }
    },
    "Hide Thinking collapses a reasoning model's <think> blocks behind a “Thinking” line in the transcript; tap it to expand or copy the reasoning. The full text is always kept in the saved history." : {
      "comment" : "LLM settings footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Denkprozess ausblenden“ klappt die <think>-Blöcke eines Reasoning-Modells hinter einer Zeile „Denkt“ im Verlauf zusammen; tippe darauf, um die Überlegungen auszuklappen oder zu kopieren. Der vollständige Text bleibt im gesicherten Verlauf immer erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar razonamiento contrae los bloques <think> de un modelo de razonamiento tras una línea “Razonando” en la transcripción; tócala para expandir o copiar el razonamiento. El texto completo siempre se conserva en el historial guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer la réflexion replie les blocs <think> d'un modèle de raisonnement derrière une ligne « Réflexion » dans la transcription ; touchez-la pour développer ou copier le raisonnement. Le texte complet est toujours conservé dans l'historique enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「思考を隠す」は、推論モデルの <think> ブロックをトランスクリプト内の“思考”行に折りたたみます。タップすると推論を展開またはコピーできます。全文は常に保存された履歴に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생각 숨기기는 추론 모델의 <think> 블록을 대화 기록에서 “생각 중” 줄 뒤로 접습니다. 탭하여 추론을 펼치거나 복사하십시오. 전체 텍스트는 항상 저장된 기록에 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar Raciocínio recolhe os blocos <think> de um modelo de raciocínio atrás de uma linha “Raciocínio” na transcrição; toque nela para expandir ou copiar o raciocínio. O texto completo sempre fica no histórico salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Скрывать рассуждения» сворачивает блоки <think> модели с рассуждениями в строку «Рассуждения» в беседе; коснитесь её, чтобы развернуть или скопировать рассуждения. Полный текст всегда хранится в сохранённой истории."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“隐藏思考过程”会将推理模型的 <think> 块折叠到对话记录中的“思考中”一行之后；轻点即可展开或拷贝推理内容。完整文本始终保留在已保存的历史记录中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「隱藏思考過程」會將推理模型的 <think> 區塊收合在對話記錄中的「思考中」行之後；點一下即可展開或拷貝推理內容。完整文字一律保留在已儲存的記錄中。"
          }
        }
      }
    },
