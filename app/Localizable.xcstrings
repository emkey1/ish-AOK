          }
        }
      }
    },
    "Pick the Classic or Modern workspace experience. Both stay available; this only changes how the desktop and its windows look and behave." : {
      "comment" : "workspace style sheet message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den klassischen oder modernen Workspace. Beide bleiben verfügbar; dies ändert nur Aussehen und Verhalten des Desktops und seiner Fenster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la experiencia de espacio de trabajo Clásico o Moderno. Ambas siguen disponibles; esto solo cambia el aspecto y el comportamiento del escritorio y sus ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'expérience d'espace de travail Classique ou Moderne. Les deux restent disponibles ; cela ne change que l'aspect et le comportement du bureau et de ses fenêtres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「クラシック」または「モダン」のワークスペースを選択してください。どちらもいつでも選択でき、デスクトップとそのウインドウの外観と動作のみが変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클래식 또는 모던 워크스페이스 환경을 선택하십시오. 둘 다 계속 사용할 수 있으며, 데스크탑과 윈도우의 모양과 동작만 바뀝니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a experiência Clássica ou Moderna do espaço de trabalho. Ambas continuam disponíveis; isso só muda a aparência e o comportamento da área de trabalho e suas janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите классическую или современную рабочую область. Обе остаются доступными; меняется только вид и поведение рабочего стола и его окон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“经典”或“现代”工作区体验。两者都可随时选用；此选项只改变桌面及其窗口的外观和行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「經典」或「現代」工作區體驗。兩者都可使用；這只會改變桌面及其視窗的外觀和行為。"
          }
        }
      }
    },
    "Pin Tab to Current Page" : {
      "comment" : "browser tab action",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab an aktuelle Seite anheften"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
