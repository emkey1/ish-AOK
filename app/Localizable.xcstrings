    "I can't be bothered to implement any undo or regret UI so this is irreversible." : {
      "comment" : "Delete filesystem confirmation message (deliberately informal)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hatte keine Lust, ein Rückgängig oder eine Reue-Funktion zu bauen, also ist das endgültig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No me apetece implementar ninguna interfaz para deshacer o arrepentirse, así que esto es irreversible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n'ai pas eu le courage de coder une annulation ou une interface de regret, donc c'est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消しや後悔のための UI を実装する気はないので、この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 취소나 후회 UI를 구현하기 귀찮아서 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não estou a fim de implementar qualquer interface de desfazer ou arrependimento, então isto é irreversível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мне лень делать отмену или какой-то интерфейс для сожалений, так что это необратимо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我懒得实现任何撤销或后悔的界面，所以此操作不可逆。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
