    "Models lists the saved destinations -- provider, server, model and key -- that chats choose from with their model button." : {
      "comment" : "LLM settings footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Modelle“ listet die gesicherten Ziele – Anbieter, Server, Modell und Schlüssel –, aus denen Chats über ihre Modelltaste wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos muestra los destinos guardados -- proveedor, servidor, modelo y clave -- entre los que eligen los chats con su botón de modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèles liste les destinations enregistrées -- fournisseur, serveur, modèle et clé -- parmi lesquelles les conversations choisissent avec leur bouton Modèle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「モデル」には保存済みの接続先（プロバイダ、サーバ、モデル、キー）が一覧表示され、各チャットはモデルボタンでそこから選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델에는 채팅이 모델 버튼으로 선택하는 저장된 대상(제공자, 서버, 모델 및 키)이 나열됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos lista os destinos salvos -- provedor, servidor, modelo e chave -- que os chats escolhem com o botão de modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Модели» — это сохранённые подключения (провайдер, сервер, модель и ключ), из которых чаты выбирают кнопкой модели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“模型”列出已保存的目标（提供商、服务器、模型和密钥），供聊天通过模型按钮选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「模型」會列出已儲存的服務 -- 供應商、伺服器、模型和金鑰 -- 對話可透過其模型按鈕從中選擇。"
          }
        }
      }
    },
