        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava esta sessão no disco para que a próxima abertura a retome. Toque e mantenha pressionado para opções da sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает этот сеанс на диск, чтобы при следующем запуске продолжить его. Коснитесь и удерживайте для параметров сеанса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
