    "This closes that Workspace window. Running terminals in that Workspace may be detached or closed with the scene." : {
      "comment" : "close workspace alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies schließt dieses Workspace-Fenster. Laufende Terminals in diesem Workspace werden evtl. mit der Szene getrennt oder geschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto cierra esa ventana del espacio de trabajo. Las terminales en ejecución en ese espacio de trabajo pueden desconectarse o cerrarse con la escena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ferme cette fenêtre d'espace de travail. Les terminaux en cours dans cet espace de travail peuvent être détachés ou fermés avec la scène."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのワークスペースウインドウを閉じます。そのワークスペースで実行中のターミナルは、シーンと一緒に切り離されるか閉じられる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 워크스페이스 윈도우를 닫습니다. 해당 워크스페이스에서 실행 중인 터미널은 장면과 함께 분리되거나 닫힐 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso fecha aquela janela do Espaço de trabalho. Terminais em execução nesse Espaço de trabalho podem ser desconectados ou fechados com a cena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это окно рабочей области будет закрыто. Терминалы, запущенные в этой рабочей области, могут быть отсоединены или закрыты вместе со сценой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将关闭该工作区窗口。该工作区中运行的终端可能会随场景一起被分离或关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會關閉該工作區視窗。該工作區中執行的終端機可能會隨場景分離或關閉。"
          }
        }
      }
    },
    "This deletes \"%@\" and %lu item inside it." : {
