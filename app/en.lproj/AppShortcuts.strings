/* The Siri phrases of app/ISHAppShortcuts.swift.
   AppShortcuts.xcstrings is refused below iOS 17 ("use AppShortcuts.strings
   for previous versions") and this app targets iOS 15, so this surface is a
   legacy .strings table per language rather than a catalogue. Every phrase
   must keep ${applicationName}: Siri matches a phrase only when the app name
   is in it. Keys come from the build's own extraction -- the AppShortcuts
   table of ExtractedAppShortcutsMetadata.stringsdata. */

"Open workspace in ${applicationName}" = "Open workspace in ${applicationName}";
"Show dashboard in ${applicationName}" = "Show dashboard in ${applicationName}";
"Open session shell in ${applicationName}" = "Open session shell in ${applicationName}";
"Open shell in ${applicationName}" = "Open shell in ${applicationName}";
"Open system console in ${applicationName}" = "Open system console in ${applicationName}";
"Open console in ${applicationName}" = "Open console in ${applicationName}";
"Open browser in ${applicationName}" = "Open browser in ${applicationName}";
"Show browser in ${applicationName}" = "Show browser in ${applicationName}";
"Open themes in ${applicationName}" = "Open themes in ${applicationName}";
"Show themes in ${applicationName}" = "Show themes in ${applicationName}";
"Open boot images in ${applicationName}" = "Open boot images in ${applicationName}";
"Show boot images in ${applicationName}" = "Show boot images in ${applicationName}";
