/* The Siri phrases of app/ISHAppShortcuts.swift.
   AppShortcuts.xcstrings is refused below iOS 17 ("use AppShortcuts.strings
   for previous versions") and this app targets iOS 15, so this surface is a
   legacy .strings table per language rather than a catalogue. Every phrase
   must keep ${applicationName}: Siri matches a phrase only when the app name
   is in it. Keys come from the build's own extraction -- the AppShortcuts
   table of ExtractedAppShortcutsMetadata.stringsdata. */

"Open workspace in ${applicationName}" = "Abrir el espacio de trabajo en ${applicationName}";
"Show dashboard in ${applicationName}" = "Mostrar el panel en ${applicationName}";
"Open session shell in ${applicationName}" = "Abrir el shell de sesión en ${applicationName}";
"Open shell in ${applicationName}" = "Abrir el shell en ${applicationName}";
"Open system console in ${applicationName}" = "Abrir la consola del sistema en ${applicationName}";
"Open console in ${applicationName}" = "Abrir la consola en ${applicationName}";
"Open browser in ${applicationName}" = "Abrir el navegador en ${applicationName}";
"Show browser in ${applicationName}" = "Mostrar el navegador en ${applicationName}";
"Open themes in ${applicationName}" = "Abrir los temas en ${applicationName}";
"Show themes in ${applicationName}" = "Mostrar los temas en ${applicationName}";
"Open boot images in ${applicationName}" = "Abrir las imágenes de arranque en ${applicationName}";
"Show boot images in ${applicationName}" = "Mostrar las imágenes de arranque en ${applicationName}";
