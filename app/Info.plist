<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Workstation</string>
	<!-- Root filesystem archives: Files' Share and another app's "Open in"
	     list the app for these, and an archive handed over that way is
	     offered for import as a new filesystem (SceneDelegate.m,
	     ISHSceneOfferRootArchiveImport). Alternate, not Owner: opening a .gz
	     in Files still does what it did. The types are the ones iOS declares
	     for the compressions the importer reads (libarchive, Roots.m); .zst
	     has no system type, so .tar.zst still goes through
	     /AOK/persist/roots or manage-roots.sh. Keep this list and
	     RootArchiveContentTypes() in RootsTableViewController.m the same. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Root Filesystem Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.tar-archive</string>
				<string>org.gnu.gnu-tar-archive</string>
				<string>org.gnu.gnu-zip-archive</string>
				<string>org.gnu.gnu-zip-tar-archive</string>
				<string>public.bzip2-archive</string>
				<string>public.tar-bzip2-archive</string>
				<string>org.tukaani.xz-archive</string>
				<string>org.tukaani.tar-xz-archive</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance. The app carries encryption that is not the
	     operating system's. OpenSSH is configured without OpenSSL and falls
	     back to its own ChaCha20-Poly1305 and Ed25519 (meson.build:820-832);
	     the root filesystems, which go to every user, carry OpenSSL (Alpine's
	     libcrypto3/libssl3), libgcrypt (Devuan) and OpenSSH (the native
	     root); and Crypto Accel maps guest AES and SHA instructions onto the
	     host's ARMv8 crypto extensions.

	     All of it is IETF/NIST-standard, which is the middle row of Apple's
	     table (developer.apple.com/help/app-store-connect/reference/
	     app-information/export-compliance-documentation-for-encryption): an
	     industry-standard algorithm not provided by the OS. No CCATS. That
	     row needs one document, the French encryption declaration, and only
	     for distribution in France.

	     Decided 2026-11-26: the app is not distributed in France and no
	     declaration will be filed, so the app needs no documentation, and
	     Apple's "Complying with Encryption Export Regulations" says to set
	     this key to NO when the app "only uses forms of encryption that are
	     exempt from export compliance documentation requirements". NO also
	     ends the encryption questions App Store Connect asked for each build.

	     If France is ever turned on, this must become YES together with
	     ITSEncryptionExportComplianceCode, the code Apple issues once the
	     French declaration is accepted. YES without the code is refused at
	     upload: build 566 got error 90592 ("export compliance key value []
	     doesn't match"). See docs/app_store_assessment.md. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- NO: an archive opened from another app arrives as a copy in
	     Documents/Inbox, which the import deletes when it is done. YES would
	     hand over the original, but together with UIFileSharingEnabled it
	     would also list the app's Documents folder in the Files app, which it
	     has never been. App Store Connect wants this key set whenever
	     CFBundleDocumentTypes is (ITMS-90737). -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- NSAllowsLocalNetworking must NOT be added back beside this.
		     It is one of the keys iOS 10 introduced, and the presence of any
		     of them makes NSAllowsArbitraryLoads be ignored on iOS 10 and
		     later -- it is kept only for older systems. The two together
		     therefore read as "allow everything" and mean "allow local
		     networking and the exception domains below", which is how plain
		     HTTP to a public host came to fail in the app while HTTPS and
		     localhost worked. Arbitrary loads is strictly the broader of the
		     two, so nothing is lost by letting it apply.

		     Xcode rewrites this file alphabetically when it edits it, and it
		     drops XML comments when it does -- this one was lost that way
		     once already. If it goes missing again, put it back. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>::1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_ssh._tcp</string>
		<string>_http._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Programs you run in AOK-Workstation, such as ssh, ping and curl, connect to devices on your local network, and other devices can connect to servers you start, such as sshd.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Programs running in AOK-Workstation will be allowed to track your location in the background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Programs running in AOK-Workstation will be allowed to track your location in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Programs running in AOK-Workstation will be allowed to see your location.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AOK-Workstation deletes a video from your library only when you choose Delete Original in the Media Converter.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>AOK-Workstation adds to your photo library when you choose Save Image, or save a converted video to Photos.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>app.ish.scene</string>
		<string>app.ish.scene.terminal</string>
		<string>app.ish.scene.workspace</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>Main App</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Terminal</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest~iphone</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>Main App</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Terminal</string>
				</dict>
			</array>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>External Display</string>
					<key>UISceneDelegateClassName</key>
					<string>ExternalDisplaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Terminal</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>fuc</key>
	<string>ICON_STUFF</string>
</dict>
</plist>
