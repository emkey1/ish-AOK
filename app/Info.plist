<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Workstation</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The app carries encryption that is not the operating system's. OpenSSH is configured without OpenSSL and falls back to its
	     own ChaCha20-Poly1305 and Ed25519 (meson.build:820-832); the bundled root
	     filesystems, which go to every user, carry OpenSSL (Alpine's
	     libcrypto3/libssl3) and libgcrypt (Devuan); and Crypto Accel maps
	     guest AES and SHA instructions onto the host's ARMv8 crypto
	     extensions.

	     All of it is IETF/NIST-standard, which is the middle row of Apple's
	     table (developer.apple.com/help/app-store-connect/reference/
	     export-compliance-documentation-for-encryption): an industry-standard
	     algorithm not provided by the OS. No CCATS. That row needs one
	     document, the French encryption declaration, and only for
	     distribution in France.

	     Decided 2026-11-26: the app is not distributed in France and no
	     declaration will be filed, so Apple needs no documentation.

	     The key is NOT set. Build 566 shipped it as
	     ITSAppUsesNonExemptEncryption = YES with no code, and the upload was
	     refused (90592, "export compliance key value [] doesn't match"), so
	     the encryption questions are answered per build in App Store Connect:
	     standard encryption, not distributed in France. Apple's
	     "Complying with Encryption Export Regulations" says to set the key to
	     NO for encryption "exempt from export compliance documentation
	     requirements", which would end those questions; not done without the
	     maintainer's word. See docs/app_store_assessment.md. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- NSAllowsLocalNetworking must NOT be added back beside this.
		     It is one of the keys iOS 10 introduced, and the presence of any
		     of them makes NSAllowsArbitraryLoads be ignored on iOS 10 and
		     later -- it is kept only for older systems. The two together
		     therefore read as "allow everything" and mean "allow local
		     networking and the exception domains below", which is how plain
		     HTTP to a public host came to fail in the app while HTTPS and
		     localhost worked. Arbitrary loads is strictly the broader of the
		     two, so nothing is lost by letting it apply.

		     Xcode rewrites this file alphabetically when it edits it, and it
		     drops XML comments when it does -- this one was lost that way
		     once already. If it goes missing again, put it back. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>::1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_ssh._tcp</string>
		<string>_http._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Programs you run in AOK-Workstation, such as ssh, ping and curl, connect to devices on your local network, and other devices can connect to servers you start, such as sshd.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Programs running in AOK-Workstation will be allowed to track your location in the background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Programs running in AOK-Workstation will be allowed to track your location in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Programs running in AOK-Workstation will be allowed to see your location.</string>
	<key>NSPhotoLibraryUsageDescription</key>
