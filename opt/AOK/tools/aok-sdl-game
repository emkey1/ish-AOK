#!/bin/sh
# aok-sdl-game -- start an SDL game from /usr/games the way it works best
# under iSH-AOK. Installed by /AOK/tools/setup-games.sh as
# /usr/local/bin/aok-sdl-game, with a symlink per game (/usr/local/bin/sky,
# /usr/local/bin/freedoom1, ...) that PATH finds before /usr/games.
#
#   - sound through the app's /dev/dsp (SDL's OSS driver)
#   - the Wayland desktop, when there is one
#   - OpenGL on the GPU (zink) for the games named in /etc/aok-games.conf's
#     AOK_GAMES_GPU, in software for the rest: zink gives only OpenGL 2.1 /
#     ES 2.0, and older GPUs (A10X) cannot run it at all
#
# The desktop exports LIBGL_ALWAYS_SOFTWARE=1 to everything it starts, so the
# GPU list overrides it; AOK_GAMES_GL=gpu or =software in the environment
# overrides the list for one run. Sound and video variables already set win.
name=${0##*/}
if [ "$name" = aok-sdl-game ]; then
    echo "aok-sdl-game: run it through a game's symlink (see /AOK/tools/setup-games.sh)" >&2
    exit 2
fi

AOK_GAMES_GPU=
[ -r /etc/aok-games.conf ] && . /etc/aok-games.conf

# Sound: SDL's OSS driver, and OpenAL's, on the app's /dev/dsp.
if [ -w /dev/dsp ]; then
    export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-dsp}"
    export ALSOFT_DRIVERS="${ALSOFT_DRIVERS:-oss}"
fi
[ -n "${WAYLAND_DISPLAY:-}" ] && export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland}"

# The desktop's X display, for the X11-only games: the Xwayland lock whose pid
# is the running compositor's (start-wayland.sh's rule; a terminal started
# before it could tell may not have DISPLAY).
x_display() {
    for lock in /tmp/.X*-lock; do
        [ -f "$lock" ] || continue
        pid=""
        read -r pid < "$lock" 2>/dev/null
        case "$(cat /proc/"$pid"/comm 2>/dev/null)" in
            labwc|sway) lock=${lock#/tmp/.X}; echo ":${lock%-lock}"; return ;;
        esac
    done
}

target="/usr/games/$name"

case "$name" in
    # SFML and GLEW draw through X11 only: Xwayland, which has the GPU too.
    etr|trigger-rally)
        [ -z "${DISPLAY:-}" ] && DISPLAY=$(x_display) && export DISPLAY
        export SDL_VIDEODRIVER=x11
        ;;
    # Debian's launcher runs the game in a bubblewrap sandbox, which needs
    # namespaces AOK does not have; and its Vulkan renderer is the one that
    # reaches the GPU (its OpenGL one needs 3.0, zink here has 2.1).
    warzone2100)
        target=/usr/games/warzone2100.real
        case " $* " in *" --gfxbackend"*) ;; *) set -- --gfxbackend=vulkan "$@" ;; esac
        ;;
esac

gl=${AOK_GAMES_GL:-}
if [ -z "$gl" ]; then
    case " $AOK_GAMES_GPU " in
        *" $name "*) gl=gpu ;;
        *) gl=software ;;
    esac
fi
if [ "$gl" = gpu ]; then
    export LIBGL_ALWAYS_SOFTWARE=0 MESA_LOADER_DRIVER_OVERRIDE=zink
else
    export LIBGL_ALWAYS_SOFTWARE=1 SDL_RENDER_DRIVER="${SDL_RENDER_DRIVER:-software}"
    unset MESA_LOADER_DRIVER_OVERRIDE
fi

exec "$target" "$@"
